<?xml version="1.0" encoding="UTF-8"?>
<Group id="xccdf_org.example_group_{{ group_id }}" xml:lang="en">
  <title>{{ group_title }}</title>
  <description>{{ group_desc }}</description>
  <Rule id="xccdf_org.example_rule_{{ rule_id }}" severity="{{ severity }}" weight="10.0">
    <title>{{ title }}</title>
    <description><VulnDiscussion>{{ vuln_discussion }}</VulnDiscussion></description>
    <reference href="https://csrc.nist.gov/projects/risk-management-framework">{{ nist_control }}</reference>
    <ident system="http://cyber.mil/cci">{{ cci }}</ident>
    <rationale>{{ rationale }}</rationale>
    <check system="C-customos-manual"><check-content><![CDATA[{{ manual_check }}]]></check-content></check>
    <fixtext fixref="fix_{{ rule_id }}"><![CDATA[{{ fix_text }}]]></fixtext>
  </Rule>
</Group>